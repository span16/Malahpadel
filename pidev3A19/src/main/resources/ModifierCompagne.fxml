<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="398.0" prefWidth="340.0" spacing="10" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ModifierCompagneController">

    <Label prefHeight="68.0" prefWidth="248.0" style="-fx-font-size: 18px;" text="Modifier Campagne" />

    <TextField fx:id="nomSponsorField" promptText="Nom du Sponsor" />
    <TextField fx:id="dateDebutField" promptText="Date Début (YYYY-MM-DD)" />
    <TextField fx:id="dateFinField" promptText="Date Fin (YYYY-MM-DD)" />
    <TextField fx:id="logoField" promptText="URL du Logo" />
    <TextField fx:id="typeMarketingField" promptText="Type Marketing" />
    <TextField fx:id="statusField" promptText="Status" />
    <TextField fx:id="tarifsField" promptText="Tarifs" />

    <HBox prefHeight="75.0" prefWidth="248.0" spacing="10">
        <Button fx:id="annulerButton" text="Annuler" />
        <Button fx:id="modifierButton" text="Modifier" />
    </HBox>

</VBox>
