<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="455.0" prefWidth="650.0" spacing="20" style="-fx-background-color: #f5f5f5; -fx-padding: 20;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.CompagneFrontliste">

    <!-- Titre et bouton de fermeture -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #333;" text="Campagnes Marketing" />
    </HBox>

    <!-- Conteneur des cartes campagnes (dynamique) -->
    <FlowPane fx:id="compagnesContainer" hgap="20" prefHeight="400.0" prefWidth="760.0" style="-fx-padding: 10;" vgap="20">
        <!-- Les campagnes seront ajoutées dynamiquement ici via JavaFX -->
    </FlowPane>

    <!-- Bouton Ajouter Campagne -->
    <Button fx:id="ajouterCompagneBtn" onAction="#ajouterCampagne" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 16; -fx-padding: 10 20; -fx-border-radius: 5;" text="Ajouter Campagne" />

</VBox>
