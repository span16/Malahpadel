<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="10" style="-fx-padding: 20;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ModifierProduitFrontController">
    <Label text="Modifier un produit" style="-fx-font-size: 18; -fx-font-weight: bold;" />
    <TextField fx:id="nomField" promptText="Nom du produit" />
    <TextField fx:id="categorieField" promptText="Catégorie" />
    <ImageView fx:id="imagePreview" fitHeight="150" fitWidth="150" preserveRatio="true" />
    <TextArea fx:id="descriptionField" promptText="Description" />
    <TextField fx:id="prixField" promptText="Prix" />
    <TextField fx:id="stockField" promptText="Stock" />
    <Button text="Valider" onAction="#validerModification" style="-fx-background-color: #2ecc71; -fx-text-fill: white;" />
</VBox>