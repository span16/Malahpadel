<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="560.0" prefWidth="686.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.CompagneFormControllerA">
    <stylesheets>
        <URL value="@style.css" /> <!-- Lien vers un fichier CSS pour le style -->
    </stylesheets>

    <!-- Titre de l'interface -->
    <Text layoutX="50" layoutY="50" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-fill: #2c3e50;" text="Gestion des Campagnes Marketing" />

    <!-- Conteneur principal pour le formulaire -->
    <VBox layoutX="50" layoutY="80" spacing="10" style="-fx-background-color: #ecf0f1; -fx-padding: 20px; -fx-border-radius: 10px; -fx-background-radius: 10px;">
        <!-- Champ pour le nom du sponsor -->
        <HBox spacing="10">
            <Label style="-fx-font-weight: bold;" text="Nom du Compagne:" />
            <TextField fx:id="nomSponsorTf" promptText="Entrez le nom du compagne" style="-fx-pref-width: 300px;" />
        </HBox>

        <!-- Champ pour la date de début -->
        <HBox spacing="10">
            <Label style="-fx-font-weight: bold;" text="Date de Début:" />
            <DatePicker fx:id="dateDebutPicker" style="-fx-pref-width: 300px;" />
        </HBox>

        <!-- Champ pour la date de fin -->
        <HBox spacing="10">
            <Label style="-fx-font-weight: bold;" text="Date de Fin:" />
            <DatePicker fx:id="dateFinPicker" style="-fx-pref-width: 300px;" />
        </HBox>

        <!-- Champ pour le logo de la campagne -->
        <HBox spacing="10">
            <Label style="-fx-font-weight: bold;" text="Logo de la Campagne:" />
            <Button fx:id="selectLogoBtn" onAction="#selectLogo" text="Sélectionner un logo" />
            <ImageView fx:id="logoImageView" fitHeight="100" fitWidth="100" style="-fx-border-color: #bdc3c7; -fx-border-radius: 5px;" />
        </HBox>

        <!-- Champ pour le type de marketing -->
        <HBox spacing="10">
            <Label style="-fx-font-weight: bold;" text="Type de Marketing:" />
            <ComboBox fx:id="typeMarketingComboBox" style="-fx-pref-width: 300px;" />
        </HBox>

        <!-- Champ pour le statut de la campagne -->
        <HBox spacing="10">
            <Label style="-fx-font-weight: bold;" text="Statut:" />
            <ComboBox fx:id="statusComboBox" style="-fx-pref-width: 300px;" />
        </HBox>

        <!-- Champ pour les tarifs -->
        <HBox spacing="10">
            <Label style="-fx-font-weight: bold;" text="Tarifs:" />
            <TextField fx:id="tarifsTf" promptText="Entrez les tarifs" style="-fx-pref-width: 300px;" />
        </HBox>

        <HBox spacing="10">
            <Label style="-fx-font-weight: bold;" text=" Nom Produit:" />
            <ComboBox fx:id="idProduitComboBox" promptText="Sélectionnez un produit" />        </HBox>

        <HBox alignment="CENTER_RIGHT" spacing="10">
            <Button onAction="#annuler" style="-fx-background-color: #e74c3c; -fx-text-fill: white;" text="Annuler" />
            <Button onAction="#valider" style="-fx-background-color: #2ecc71; -fx-text-fill: white;" text="Valider" />
         <Button fx:id="affichcomp" onAction="#affichercompagne" style="-fx-background-color: #6999d0; -fx-text-fill: white;" text="liste Compagne" />
        </HBox>
    </VBox>
   <Button fx:id="produitinterface" layoutX="612.0" layoutY="28.0" mnemonicParsing="false" onAction="#interfaceproduit" text="Produit" />
</AnchorPane>
