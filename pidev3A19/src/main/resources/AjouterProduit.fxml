<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Text?>

<AnchorPane id="AnchorPane" prefHeight="700.0" prefWidth="1000.0" styleClass="Box" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.AjouterProduitController">
    <stylesheets>
        <URL value="@style.css" /> <!-- Lien vers le fichier CSS -->
    </stylesheets>
    <children>
        <Text layoutX="29.0" layoutY="50.0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-fill: #333333;" text="Gestion des Produits" />
        <Label layoutX="29.0" layoutY="120.0" text="Nom du produit:" />
        <TextField fx:id="nomProduitTf" layoutX="29.0" layoutY="145.0" prefHeight="27.0" prefWidth="338.0" promptText="Entrez le nom du produit" styleClass="TextField" />
        <Label layoutX="29.0" layoutY="175.0" text="Catégorie:" />
        <TextField fx:id="categorieTf" layoutX="29.0" layoutY="200.0" prefHeight="27.0" prefWidth="338.0" promptText="Entrez la catégorie du produit" styleClass="TextField" />
        <Label layoutX="29.0" layoutY="230.0" text="Image du produit:" />
        <TextField fx:id="imageProduitTf" layoutX="29.0" layoutY="255.0" prefHeight="27.0" prefWidth="338.0" promptText="Chemin de l'image (ex : image.jpg)" styleClass="TextField" />
        <Label layoutX="29.0" layoutY="285.0" text="Description:" />
        <TextArea fx:id="descriptionTa" layoutX="29.0" layoutY="310.0" prefHeight="112.0" prefWidth="338.0" promptText="Entrez une description détaillée du produit..." styleClass="TextArea" />
        <Label layoutX="29.0" layoutY="435.0" text="Prix:" />
        <TextField fx:id="prixTf" layoutX="29.0" layoutY="450.0" prefHeight="27.0" prefWidth="338.0" promptText="prix " styleClass="TextField" />
        <Label layoutX="29.0" layoutY="485.0" text="Stock:" />
        <TextField fx:id="stockTf" layoutX="29.0" layoutY="505.0" prefHeight="27.0" prefWidth="338.0" promptText="# Quantité en stock (ex : 50)" styleClass="TextField" />
        <Button text="Ajouter" onAction="#addProduit" fx:id="addBtn" layoutX="357.0" layoutY="540.0" mnemonicParsing="false" prefHeight="40" prefWidth="80" styleClass="GeneralButton" />
    </children>
</AnchorPane>
