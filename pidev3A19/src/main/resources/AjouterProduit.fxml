<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ButtonBar?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Text?>

<AnchorPane id="AnchorPane" prefHeight="700.0" prefWidth="1000.0" styleClass="Box" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.AjouterProduitController">
    <stylesheets>
        <URL value="@style.css" /> <!-- Lien vers le fichier CSS -->
    </stylesheets>
    <children>
        <Text fill="#3949da" layoutX="233.0" layoutY="70.0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-fill: #333333;" text="Gestion des Produits" wrappingWidth="358.6640625" />
        <Label layoutX="136.0" layoutY="119.0" text="Nom du produit:" />
        <TextField fx:id="nomProduitTf" layoutX="136.0" layoutY="144.0" prefHeight="27.0" prefWidth="338.0" promptText="Entrez le nom du produit" styleClass="TextField" />
        <Label layoutX="136.0" layoutY="173.0" text="Catégorie:" />
        <TextField fx:id="categorieTf" layoutX="136.0" layoutY="199.0" prefHeight="27.0" prefWidth="338.0" promptText="Entrez la catégorie du produit" styleClass="TextField" />
        <Label layoutX="136.0" layoutY="229.0" text="Image du produit:" />
        <Button fx:id="selectImageBtn" layoutX="216.0" layoutY="252.0" onAction="#selectImage" text="Sélectionner une image" />
        <Label layoutX="136.0" layoutY="283.0" text="Description:" />
        <TextArea fx:id="descriptionTa" layoutX="136.0" layoutY="309.0" prefHeight="112.0" prefWidth="338.0" promptText="Entrez une description détaillée du produit..." styleClass="TextArea" />
        <Label layoutX="136.0" layoutY="433.0" text="Prix:" />
        <TextField fx:id="prixTf" layoutX="136.0" layoutY="449.0" prefHeight="27.0" prefWidth="338.0" promptText="prix " styleClass="TextField" />
        <Label layoutX="136.0" layoutY="478.0" text="Stock:" />
        <TextField fx:id="stockTf" layoutX="136.0" layoutY="504.0" prefHeight="27.0" prefWidth="338.0" promptText="# Quantité en stock (ex : 50)" styleClass="TextField" />
        <Button fx:id="addBtn" layoutX="357.0" layoutY="540.0" mnemonicParsing="false" onAction="#addProduit" prefHeight="40" prefWidth="80" styleClass="GeneralButton" text="Ajouter" />
        <Button fx:id="afficherBtn" layoutX="137.0" layoutY="540.0" mnemonicParsing="false" onAction="#affichebtn" prefHeight="40" prefWidth="216.0" styleClass="GeneralButton" text="afficher liste des produits " />
        <ImageView fx:id="imgpa" fitHeight="423.0" fitWidth="281.0" layoutX="492.0" layoutY="119.0" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@padel2.jpg" /> <!-- Correction ici -->
            </image>
        </ImageView>
        <ButtonBar layoutX="-86.0" layoutY="24.0" prefHeight="40.0" prefWidth="200.0">
            <buttons>
                <Button fx:id="compagnegestion" mnemonicParsing="false" onAction="#gestioncomp" text="Compagne " />
            </buttons>
        </ButtonBar>
    </children>
</AnchorPane>
