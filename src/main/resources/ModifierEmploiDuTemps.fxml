<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.control.Separator?>
<?import java.net.URL?>

<?import javafx.scene.layout.ColumnConstraints?>
<BorderPane xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.ModifierEmploiDuTempsController"
            styleClass="background">
    <!-- Inclusion de la navbar dans le top -->
    <top>
        <fx:include source="Navbar.fxml"/>
    </top>

    <!-- Zone centrale pour le contenu -->
    <center>
        <VBox spacing="10" alignment="CENTER" BorderPane.alignment="CENTER"
              style="-fx-padding: 10;">
            <!-- Partie haute : TableView Google Calendar + bouton -->
            <Label text="Liste des événements Google Calendar" styleClass="label"/>
            <TableView fx:id="tableEvents" prefHeight="200.0">
                <columns>
                    <TableColumn fx:id="colNom" text="Nom" prefWidth="200"/>
                    <TableColumn fx:id="colDate" text="Date" prefWidth="200"/>
                    <TableColumn fx:id="colPartie" text="Partie" prefWidth="100"/>
                </columns>
            </TableView>
            <HBox alignment="CENTER" spacing="10">
                <Button text="Charger Google Calendar" onAction="#loadGoogleCalendarEvents" styleClass="btn-secondary"/>
            </HBox>

            <Separator/>

            <!-- Formulaire de sélection / modification de l'EmploiDuTemps -->
            <Label text="Sélection et modification de l'Emploi du Temps" style="-fx-font-weight: bold;"/>
            <GridPane hgap="10" vgap="10">
                <columnConstraints>
                    <ColumnConstraints minWidth="120"/>
                    <ColumnConstraints minWidth="200"/>
                </columnConstraints>

                <!-- ComboBox pour choisir l'EmploiDuTemps -->
                <Label text="Choisir un Emploi du Temps :" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="label"/>
                <ComboBox fx:id="comboEdt" GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="combo-box"/>

                <Label text="Date :" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="label"/>
                <DatePicker fx:id="datePicker" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="date-picker"/>

                <Label text="Partie :" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="label"/>
                <TextField fx:id="txtPartie" GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="text-field"/>

                <Label text="Tournoi :" GridPane.rowIndex="3" GridPane.columnIndex="0" styleClass="label"/>
                <ComboBox fx:id="comboTournoi" GridPane.rowIndex="3" GridPane.columnIndex="1" styleClass="combo-box"/>

                <Label text="Équipe 1 :" GridPane.rowIndex="4" GridPane.columnIndex="0" styleClass="label"/>
                <ComboBox fx:id="comboEquipe1" GridPane.rowIndex="4" GridPane.columnIndex="1" styleClass="combo-box"/>

                <Label text="Équipe 2 :" GridPane.rowIndex="5" GridPane.columnIndex="0" styleClass="label"/>
                <ComboBox fx:id="comboEquipe2" GridPane.rowIndex="5" GridPane.columnIndex="1" styleClass="combo-box"/>
            </GridPane>

            <!-- Boutons -->
            <HBox alignment="CENTER" spacing="20">
                <Button fx:id="btnModifier" text="Modifier" onAction="#modifierEmploiDuTemps" styleClass="btn-primary"/>
                <Button fx:id="btnAnnuler" text="Annuler" onAction="#fermerFenetre" styleClass="btn-secondary"/>
            </HBox>
        </VBox>
    </center>

    <stylesheets>
        <!-- Chemin relatif vers votre fichier CSS -->
        <URL value="@padel.css" />
    </stylesheets>
</BorderPane>
