<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" alignment="CENTER" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="tn.esprit.Controller.RechercheController">

    <Label text="Gestion des Recherches" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <!-- Formulaire pour ajouter/modifier -->
    <HBox spacing="10" alignment="CENTER">
        <Label text="Nom :"/>
        <TextField fx:id="nomField"/>

        <Label text="Niveau :"/>
        <TextField fx:id="niveauField"/>

        <Label text="Annonces :"/>
        <TextField fx:id="annoncesField"/>

        <Button text="Ajouter" fx:id="ajouterBtn" onAction="#ajouterRecherche"/>
        <Button text="Modifier" fx:id="modifierBtn" onAction="#modifierRecherche"/>
        <Button text="Supprimer" fx:id="supprimerBtn" onAction="#supprimerRecherche"/>
    </HBox>

    <!-- Liste des recherches -->
    <VBox fx:id="recherchesVBox" spacing="10" alignment="CENTER"/>

</VBox>
