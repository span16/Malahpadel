<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<VBox spacing="15" alignment="CENTER" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.AjouterEmploiDuTempsController">
    <!-- Titre -->
    <Label text="Ajouter Emploi du Temps" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <!-- Sélection du tournoi -->
    <ComboBox fx:id="comboTournoi" promptText="Sélectionnez un tournoi" prefWidth="300"/>

    <!-- Date du match -->
    <DatePicker fx:id="datePicker" promptText="Choisissez la date"/>

    <!-- Boutons d'action -->
    <HBox spacing="20" alignment="CENTER">
        <Button fx:id="btnAjouter" text="Ajouter" onAction="#ajouterEmploiDuTemps"/>
        <Button fx:id="btnAnnuler" text="Annuler" onAction="#fermerFenetre"/>
    </HBox>
</VBox>
