<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="500.0" prefWidth="600.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.AfficherPaiementController">

    <!-- TableView des paiements -->
    <TableView fx:id="paiementTable" layoutX="14.0" layoutY="14.0" prefHeight="300.0" prefWidth="570.0">
        <columns>
            <TableColumn fx:id="idPColumn" text="ID Paiement" prefWidth="100.0">
                <cellValueFactory>
                    <PropertyValueFactory property="id_P" />
                </cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="idRColumn" text="ID Réservation" prefWidth="100.0">
                <cellValueFactory>
                    <PropertyValueFactory property="id_R" />
                </cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="montantColumn" text="Montant" prefWidth="150.0">
                <cellValueFactory>
                    <PropertyValueFactory property="montant" />
                </cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="statusColumn" text="Statut Paiement" prefWidth="150.0">
                <cellValueFactory>
                    <PropertyValueFactory property="status_P" />
                </cellValueFactory>
            </TableColumn>
        </columns>
    </TableView>

    <!-- Boutons d'action sous la TableView -->
    <Button layoutX="200.0" layoutY="330.0" mnemonicParsing="false" onAction="#goToModifier" text="Modifier"
            style="-fx-background-color: blue; -fx-text-fill: white;" prefWidth="90.0" />

    <Button layoutX="400.0" layoutY="330.0" mnemonicParsing="false" onAction="#goToReservation" text="Réservation"
            style="-fx-background-color: gray; -fx-text-fill: white;" prefWidth="90.0" />


</AnchorPane>
