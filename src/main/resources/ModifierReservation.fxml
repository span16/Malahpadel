<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ModifierReservationController">
    <children>
        <!-- Labels -->
        <Label layoutX="51.0" layoutY="30.0" text="ID Réservation" />
        <Label layoutX="51.0" layoutY="70.0" text="ID Paiement" />
        <Label layoutX="51.0" layoutY="110.0" text="Nom Client" />
        <Label layoutX="51.0" layoutY="150.0" text="Email" />
        <Label layoutX="51.0" layoutY="190.0" text="Date Réservation" />
        <Label layoutX="51.0" layoutY="230.0" text="Statut" />

        <!-- Text fields -->
        <TextField fx:id="txtIdR" layoutX="180.0" layoutY="26.0" />
        <TextField fx:id="txtIdP" layoutX="180.0" layoutY="66.0" />
        <TextField fx:id="txtNomC" layoutX="180.0" layoutY="106.0" />
        <TextField fx:id="txtEmail" layoutX="180.0" layoutY="146.0" />
        <TextField fx:id="txtDateR" layoutX="180.0" layoutY="186.0" />
        <TextField fx:id="txtStatus" layoutX="180.0" layoutY="226.0" />

        <!-- Button -->
        <Button layoutX="250.0" layoutY="300.0" mnemonicParsing="false" onAction="#modifierReservation" text="Modifier" />

        <Button layoutX="150.0" layoutY="300.0" mnemonicParsing="false" onAction="#goToSupprimer" text="Supprimer" style="-fx-background-color: red; -fx-text-fill: white;" />

    </children>
</AnchorPane>
