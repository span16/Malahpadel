<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.web.WebView?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.Afficherevnet">
    <children>
        <!-- Inclusion de la Navbar (vérifiez que Navbar.fxml est dans le bon répertoire) -->
        <fx:include source="Navbar.fxml" />

        <!-- WebView pour afficher Google Maps à droite -->
        <WebView fx:id="mapView" layoutX="566.0" layoutY="45.0" prefHeight="555.0" prefWidth="387.0" />

        <!-- Titre -->
        <Label layoutX="14.0" layoutY="20.0" styleClass="title-label" text="Liste des Événements" />

        <!-- ComboBox pour filtrer par type -->
        <ComboBox fx:id="comboFiltreType" layoutX="14.0" layoutY="60.0" promptText="Filtrer par type..." />

        <!-- Bouton Retour -->
        <Button layoutX="204.0" layoutY="60.0" onAction="#retourAjouterEvent" text="Retour" />

        <!-- ScrollPane contenant le FlowPane pour les cartes d'événements -->
        <ScrollPane fx:id="scrollPane" layoutX="14.0" layoutY="96.0" prefHeight="444.0" prefWidth="550.0">
            <content>
                <FlowPane fx:id="flowPane" hgap="20.0" prefWrapLength="500.0" vgap="20.0" />
            </content>
        </ScrollPane>
    </children>
</AnchorPane>
