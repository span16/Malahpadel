<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="500.0" prefWidth="700.0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.Afficherevnet">

    <children>
        <fx:include source="Navbar.fxml" />

        <!-- Image de fond à droite -->
        <ImageView fx:id="imageView" fitHeight="500.0" fitWidth="200.0" layoutX="500.0" />

        <!-- Titre -->
        <Label layoutX="14.0" layoutY="32.0" styleClass="title-label" text="Liste des Événements" />

        <!-- TableView pour afficher les événements -->
        <TableView fx:id="tableEvenements" layoutX="20.0" layoutY="70.0" prefHeight="300.0" prefWidth="400.0">
            <columns>
                <TableColumn fx:id="colNom" prefWidth="100.0" text="Nom" />
                <TableColumn fx:id="colType" prefWidth="100.0" text="Type" />
                <TableColumn fx:id="colDate" prefWidth="100.0" text="Date" />
                <TableColumn fx:id="colTerrain" prefWidth="100.0" text="Terrain" />
            </columns>
        </TableView>

        <!-- Boutons -->
        <Button layoutX="133.0" layoutY="400.0" onAction="#retourAjouterEvent" prefHeight="42.0" prefWidth="109.0" styleClass="custom-button" text="Retour" />
        <Button layoutX="300.0" layoutY="400.0" onAction="#modifierEvent" prefHeight="26.0" prefWidth="80.0" text="Modifier" />
        <Button fx:id="btnSupprimer" layoutX="300.0" layoutY="442.0" onAction="#supprimerEvent" prefHeight="26.0" prefWidth="80.0" text="Supprimer" />

    </children>
</AnchorPane>
