<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Text?>

<AnchorPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.SupprimerPaiementController" prefHeight="300.0" prefWidth="450.0">
    <children>
        <!-- Titre de la fenêtre -->
        <Text fx:id="title" text="Supprimer un Paiement" layoutX="130" layoutY="30" style="-fx-font-size: 20px; -fx-font-weight: bold;" />

        <!-- Champ de texte pour entrer l'ID du paiement -->
        <TextField fx:id="txtIdP" layoutX="130" layoutY="100" promptText="Entrez l'ID du paiement" />

        <!-- Bouton pour supprimer le paiement -->
        <Button text="Supprimer" layoutX="130" layoutY="150" onAction="#deletePaiement" />

        <!-- Bouton pour revenir à l'écran AjouterPaiement -->
        <Button text="Retour à Ajouter" layoutX="230" layoutY="150" onAction="#goToAjouterPaiement" />


    </children>
</AnchorPane>
