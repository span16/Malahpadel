<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="anchorPane" prefHeight="400.0" prefWidth="600.0" styleClass="background" stylesheets="@../styles/profile.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.AjouterProfil">

    <children>
        <!-- Sélection de l'utilisateur -->
        <Label layoutX="430.0" layoutY="108.0" styleClass="label" text="Utilisateur" />
        <ComboBox fx:id="comboUser" layoutX="434.0" layoutY="132.0" prefHeight="25.0" prefWidth="127.0" />

        <!-- Champs de saisie -->
        <TextField fx:id="txtAvatar" layoutX="434.0" layoutY="180.0" prefHeight="25.0" prefWidth="127.0" promptText="Avatar" styleClass="input-field" />
        <TextField fx:id="txtBio" layoutX="434.0" layoutY="229.0" prefHeight="67.0" prefWidth="127.0" promptText="Bio" styleClass="input-field" />
        <TextField fx:id="txtPreferences" layoutX="434.0" layoutY="313.0" prefHeight="25.0" prefWidth="127.0" promptText="Preferences" styleClass="input-field" />

        <!-- Bouton Ajouter -->
        <Button fx:id="addBtn" layoutX="460.0" layoutY="352.0" mnemonicParsing="false" onAction="#addProfil" prefHeight="25.0" prefWidth="75.0" styleClass="general-button" text="Ajouter" />

        <!-- Labels -->
        <Label layoutX="440.0" layoutY="157.0" styleClass="label" text="Avatar" />
        <Label layoutX="440.0" layoutY="212.0" styleClass="label" text="Bio" />
        <Label layoutX="440.0" layoutY="296.0" styleClass="label" text="Preferences" />

        <!-- Titre -->
        <Label layoutX="227.0" layoutY="45.0" prefHeight="46.0" prefWidth="342.0" styleClass="sign-in-title" text="Ajouter Profil">
            <font>
                <Font size="31.0" />
            </font>
        </Label>
    </children>
</AnchorPane>
