<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="450.0" prefWidth="600.0"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.AfficherProfil" >

    <children>
        <!-- Carte du profil -->
        <VBox fx:id="profilVBox" layoutX="50.0" layoutY="50.0" prefWidth="500.0" spacing="15"
              styleClass="profil-card" alignment="CENTER">

            <!-- Avatar circulaire -->
            <ImageView fx:id="avatarImage" fitWidth="120.0" fitHeight="120.0" preserveRatio="true"
                       styleClass="avatar-circle"/>

            <!-- Informations du profil -->
            <VBox spacing="8" alignment="CENTER">
                <Label fx:id="labelNom" text="Nom: -" styleClass="profil-label"/>
                <Label fx:id="labelBio" text="Bio: -" styleClass="profil-label"/>
                <Label fx:id="labelPreferences" text="Préférences: -" styleClass="profil-label"/>
            </VBox>

            <!-- Boutons Modifier et Supprimer -->

        </VBox>
    </children>
</AnchorPane>
