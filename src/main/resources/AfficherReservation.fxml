<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="500.0" prefWidth="1008.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.AfficherReservationController">

    <TableView fx:id="reservationTable" layoutX="132.0" layoutY="22.0" prefHeight="300.0" prefWidth="762.0">
        <columns>
            <TableColumn fx:id="nombrePlacesColumn" prefWidth="179.0" text="Nombre de places">
                <cellValueFactory>
                    <PropertyValueFactory property="nombre_places" />
                </cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="typeReservationColumn" prefWidth="149.0" text="Type de réservation">
                <cellValueFactory>
                    <PropertyValueFactory property="type_reservation" />
                </cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="codeConfirmationColumn" prefWidth="156.0" text="Code de confirmation">
                <cellValueFactory>
                    <PropertyValueFactory property="code_confirmation" />
                </cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="remarqueColumn" prefWidth="129.0" text="Remarque">
                <cellValueFactory>
                    <PropertyValueFactory property="remarque" />
                </cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="evenementColumn" prefWidth="207.0" text="Événement">
                <cellValueFactory>
                    <PropertyValueFactory property="Evenement" />
                </cellValueFactory>
            </TableColumn>

        </columns>
    </TableView>

    <Button layoutX="385.0" layoutY="330.0" mnemonicParsing="false" onAction="#goToModifier" prefWidth="90.0" style="-fx-background-color: blue; -fx-text-fill: white;" text="Modifier" />

    <Button layoutX="571.0" layoutY="330.0" mnemonicParsing="false" onAction="#goToPaiement" prefWidth="90.0" style="-fx-background-color: gray; -fx-text-fill: white;" text="Paiement" />




</AnchorPane>
