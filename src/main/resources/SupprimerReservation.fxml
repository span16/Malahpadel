<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Text?>

<AnchorPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.SupprimerReservationController">
    <children>
        <!-- Titre de la fenêtre -->
        <Text fx:id="title" text="Supprimer une Réservation" layoutX="150" layoutY="30" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

        <!-- Champ de texte pour entrer l'ID de la réservation -->
        <TextField fx:id="txtIdR" layoutX="150" layoutY="100" promptText="Entrez l'ID de la réservation" />

        <!-- Bouton pour supprimer la réservation -->
        <Button text="Supprimer" layoutX="150" layoutY="150" onAction="#deleteReservation"/>

        <!-- Bouton pour revenir à l'écran AjouterReservation -->
        <Button text="Retour à Ajouter" layoutX="250" layoutY="150" onAction="#goToAjouter"/>

    </children>
</AnchorPane>
