{% extends 'base.html.twig' %}

{% block title %}Recherche Details{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1>Recherche Details</h1>

        <table class="table">
            <tbody>
                <tr>
                    <th>User ID</th>
                    <td>{{ recherche.userId }}</td>
                </tr>
                <tr>
                    <th>Nom</th>
                    <td>{{ recherche.nom }}</td>
                </tr>
                <tr>
                    <th>Niveau</th>
                    <td>{{ recherche.niveau }}</td>
                </tr>
                <tr>
                    <th>Annonces</th>
                    <td>{{ recherche.annonces }}</td>
                </tr>
            </tbody>
        </table>

        <div class="mt-4">
            <a href="{{ path('app_recherche_index') }}" class="btn btn-secondary">Back to list</a>
            <a href="{{ path('app_recherche_edit', {'id': recherche.userId}) }}" class="btn btn-primary">Edit</a>
            {{ include('recherche/_delete_form.html.twig') }}
        </div>
    </div>
{% endblock %} 