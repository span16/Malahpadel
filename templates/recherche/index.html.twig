{% extends 'base.html.twig' %}

{% block title %}Recherches{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1>Recherches</h1>

        <table class="table">
            <thead>
                <tr>
                    <th>User ID</th>
                    <th>Nom</th>
                    <th>Niveau</th>
                    <th>Annonces</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for recherche in recherches %}
                <tr>
                    <td>{{ recherche.userId }}</td>
                    <td>{{ recherche.nom }}</td>
                    <td>{{ recherche.niveau }}</td>
                    <td>{{ recherche.annonces }}</td>
                    <td>
                        <a href="{{ path('app_recherche_show', {'id': recherche.userId}) }}" class="btn btn-info btn-sm">Show</a>
                        <a href="{{ path('app_recherche_edit', {'id': recherche.userId}) }}" class="btn btn-primary btn-sm">Edit</a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5">No records found</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

        <a href="{{ path('app_recherche_new') }}" class="btn btn-success">Create new</a>
    </div>
{% endblock %} 