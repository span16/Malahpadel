{% extends 'base/base.html.twig' %}

{% block title %}Détails de l'événement{% endblock %}

{% block css %}
    {{ parent() }}
    <style>
        .star-rating {
            display: flex;
            flex-direction: row-reverse;
            justify-content: start;
            gap: 5px;
            width: 100%;
        }
        .star-rating input {
            display: none;
        }
        .star-rating label {
            cursor: pointer;
        }
        .star-rating label svg path {
            stroke: #fed7aa;
            fill: transparent;
            transition: fill 0.3s ease;
        }
        .star-rating input:checked ~ label svg path,
        .star-rating label:hover ~ label svg path,
        .star-rating label:hover svg path {
            fill: #ffc107;
        }

        .map-container {
            margin-top: 20px;
            border-radius: 8px;
            overflow: hidden;
        }

        iframe {
            width: 100%;
            height: 400px;
            border: none;
        }
    </style>
{% endblock %}

{% block body %}
<div class="container py-5">
    <h2 class="mb-4 text-center">{{ evenement.nom }}</h2>

    <div class="row">
        <div class="col-md-6">
            <img src="{{ evenement.imageUrl }}" class="img-fluid rounded shadow-sm" alt="{{ evenement.nom }}">
        </div>
        <div class="col-md-6">
            <ul class="list-group">
                <li class="list-group-item"><strong>Type :</strong> {{ evenement.type.value }}</li>
                <li class="list-group-item"><strong>Date :</strong> {{ evenement.date|date('d/m/Y') }}</li>
                <li class="list-group-item"><strong>Terrain :</strong> {{ terrain.nom }}</li>
                <li class="list-group-item"><strong>Adresse :</strong> {{ terrain.adresse }}</li>
                <li class="list-group-item"><strong>Prix/personne :</strong> {{ terrain.prixParPersonne }} TND</li>
                <li class="list-group-item"><strong>Ouverture :</strong> {{ terrain.heureOuverture }}</li>
                <li class="list-group-item"><strong>Fermeture :</strong> {{ terrain.heureFermeture }}</li>
            </ul>
        </div>
    </div>

    <hr class="my-5">
    <h4><i class="fas fa-star text-warning"></i> Noter & donner votre avis :</h4>

    {{ form_start(form) }}
        <div class="form-check mb-3">
            {{ form_row(form.isLike, {
                'label': '<i class="fas fa-thumbs-up text-warning"></i> J’aime cet événement',
                'label_html': true
            }) }}
        </div>

        <div class="mb-3">
            <label for="like_dislike_rating">Note (sur 5 étoiles)</label>
            <div class="star-rating mb-2">
                {% for i in 5..1 %}
                    <input type="radio" name="like_dislike[rating]" id="star{{ i }}" value="{{ i }}">
                    <label for="star{{ i }}">
                        <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
                        </svg>
                    </label>
                {% endfor %}
            </div>
            {{ form_widget(form.rating) }} {# Champ caché pour stocker la note #}
        </div>

        <button class="btn btn-success"><i class="fas fa-check-square"></i> Envoyer</button>
    {{ form_end(form) }}

    <hr class="my-4">
    <p>
        <i class="fas fa-thumbs-up text-warning"></i> <strong>Total des avis :</strong> {{ stats.total|default(0) }} |
        <i class="fas fa-star text-warning"></i> <strong>Note moyenne :</strong> {{ stats.moyenne|default(0)|number_format(1, '.', '') }}/5
    </p>

    <hr class="my-5">
    <h4><i class="fas fa-map-marker-alt text-danger"></i> Localisation du terrain</h4>
    <div class="map-container">
        <iframe
            src="https://www.google.com/maps?q={{ terrain.nom|url_encode }}&output=embed"
            allowfullscreen
        ></iframe>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const ratingInputs = document.querySelectorAll('.star-rating input[type="radio"]');
            const ratingField = document.getElementById('like_dislike_rating'); // ID du champ caché

            ratingInputs.forEach(input => {
                input.addEventListener('change', function () {
                    ratingField.value = this.value; // Met à jour la valeur du champ caché
                });
            });
        });
    </script>
{% endblock %}