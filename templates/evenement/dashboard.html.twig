{% extends 'back.html.twig' %}

{% block title %}Dashboard - Statistiques Power BI{% endblock %}

{% block body %}
<div class="container py-5">
    <h1 class="text-center text-light mb-4">
        <i class="mdi mdi-chart-bar"></i> Statistiques & Insights
    </h1>

    <div class="card bg-dark border border-secondary shadow-lg">
        <div class="card-body p-0">
            <iframe 
                title="Power BI Report" 
                src="https://app.powerbi.com/reportEmbed?reportId=e59202b5-ac3c-401d-b287-61190eb57991&autoAuth=true&ctid=604f1a96-cbe8-43f8-abbf-f8eaf5d85730" 
                frameborder="0" 
                allowFullScreen="true" 
                style="width: 100%; height: 600px; border: none; border-radius: 8px;">
            </iframe>
        </div>
    </div>
</div>
{% endblock %}
