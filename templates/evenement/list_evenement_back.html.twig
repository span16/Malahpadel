{% extends 'back.html.twig' %}

{% block title %}Liste des événements (Back){% endblock %}

{% block body %}
<div class="container py-5">
    <h1 class="text-center mb-4 text-light">Gestion des Événements</h1>

    <div class="mb-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
        <form method="get" class="d-flex flex-wrap gap-2 align-items-center">
            <input type="text" name="search" value="{{ app.request.get('search') }}" class="form-control bg-dark text-light" placeholder="Nom...">

            <select name="type" class="form-select bg-dark text-light">
                <option value="">Tous les types</option>
                <option value="TOURNOIS" {% if app.request.get('type') == 'TOURNOIS' %}selected{% endif %}>TOURNOIS</option>
                <option value="MATCH" {% if app.request.get('type') == 'MATCH' %}selected{% endif %}>MATCH</option>
                {# AUTRE supprimé volontairement du filtre #}
            </select>

            <input type="date" name="date" value="{{ app.request.get('date') }}" class="form-control bg-dark text-light" placeholder="Date">

            <button type="submit" class="btn btn-primary">Filtrer</button>
        </form>

        <a href="{{ path('evenement_create') }}" class="btn btn-success">Créer un événement</a>
    </div>

    <div class="row g-4">
        {% for evenement in evenements %}
            <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                <div class="card h-100 shadow-sm border border-secondary bg-dark text-light">
                    <img src="{{ evenement.imageUrl }}" class="card-img-top" alt="{{ evenement.nom }}" style="height: 180px; object-fit: cover;">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title text-info">{{ evenement.nom }}</h5>
                        <p class="card-text mb-3">
                            <strong>Type :</strong> {{ evenement.type.value }}<br>
                            <strong>Date :</strong> {{ evenement.date|date('d/m/Y') }}<br>
                            {% if evenement.terrain %}
                                <strong>Terrain :</strong> {{ evenement.terrain.nom }}
                            {% endif %}
                        </p>
                        <a href="{{ path('evenement_show', {id: evenement.id}) }}" class="btn btn-outline-info mt-auto">
                            Voir les détails
                        </a>
                    </div>
                </div>
            </div>
        {% else %}
            <p class="text-center text-warning">Aucun événement trouvé.</p>
        {% endfor %}
    </div>
</div>
{% endblock %}
