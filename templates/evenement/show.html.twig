{% extends 'base.html.twig' %}

{% block title %}Liste des événements{% endblock %}

{% block body %}
    <div class="container py-5">
        <h1 class="text-center mb-5">Nos Événements</h1>

        <div class="row g-4">
            {% for evenement in evenements %}
                <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                    <div class="card h-100 shadow-sm border-0">
                        <img src="{{ evenement.imageUrl }}" class="card-img-top" alt="{{ evenement.nom }}" style="height: 180px; object-fit: cover;">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title text-primary">{{ evenement.nom }}</h5>
                            <p class="card-text mb-3">
                                <strong>Type :</strong> {{ evenement.type.value }}<br>
                                <strong>Date :</strong> {{ evenement.date|date('d/m/Y') }}<br>
                                {% if evenement.terrain %}
                                    <strong>Terrain :</strong> {{ evenement.terrain.nom }}
                                {% endif %}
                            </p>

                            <a href="{{ path('evenement_show', {id: evenement.id}) }}" class="btn btn-outline-primary mt-auto">
                                Voir les détails
                            </a>
                        </div>
                    </div>
                </div>
            {% else %}
                <p class="text-center">Aucun événement trouvé.</p>
            {% endfor %}
        </div>
    </div>
{% endblock %}
