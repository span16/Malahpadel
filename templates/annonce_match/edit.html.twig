{% extends 'annonce_match/base.html.twig' %}

{% block title %}Modifier l'annonce{% endblock %}

{% block body %}
    <div class="card">
        <div class="card-header">
            <h1 class="h3 mb-0">Modifier l'annonce</h1>
        </div>
        <div class="card-body">
            {{ include('annonce_match/_form.html.twig', {'button_label': 'Mettre à jour'}) }}
        </div>
        <div class="card-footer">
            <a href="{{ path('app_annonce_match_index') }}" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Retour à la liste
            </a>

            <!-- Delete form inclusion with correct 'annonceId' -->
            {{ include('annonce_match/_delete_form.html.twig', {'annonce_match': annonce_match}) }}
        </div>
    </div>
{% endblock %}
