{% extends 'annonce_match/base.html.twig' %}

{% block title %}Détails de l'annonce{% endblock %}

{% block body %}
    <div class="card">
        <div class="card-header">
            <h1 class="h3 mb-0">Détails de l'annonce</h1>
        </div>
        <div class="card-body">
            <table class="table">
                <tbody>
                    <tr>
                        <th>Titre</th>
                        <td>{{ annonce_match.titre }}</td>
                    </tr>
                    <tr>
                        <th>Date</th>
                        <td>{{ annonce_match.dateHeure ? annonce_match.dateHeure|date('Y-m-d H:i') : '' }}</td>
                    </tr>
                    <tr>
                        <th>Lieu</th>
                        <td>{{ annonce_match.lieu }}</td>
                    </tr>
                    <tr>
                        <th>Joueurs Recherchés</th>
                        <td>{{ annonce_match.joueursRecherches }}</td>
                    </tr>
                    <tr>
                        <th>Niveau</th>
                        <td>{{ annonce_match.niveau }}</td>
                    </tr>
                    <tr>
                        <th>Description</th>
                        <td>{{ annonce_match.description }}</td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div class="card-footer">
            <a href="{{ path('app_annonce_match_index') }}" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Retour à la liste
            </a>
            <a href="{{ path('app_annonce_match_edit', {'annonceId': annonce_match.annonceId}) }}" class="btn btn-primary">
                <i class="fas fa-edit"></i> Modifier
            </a>
            {{ include('annonce_match/_delete_form.html.twig') }}
        </div>
    </div>
{% endblock %} 