{% extends 'base.html.twig' %}

{% block title %}
    Welcome {% if app.user %}{{ app.user.prenom }}{% else %}Guest{% endif %}
{% endblock %}

{% block body %}
    <div class="container">
    {{ dump(app.user) }}

        {% if app.user %}
            <h1>Welcome, {{ app.user.prenom }}!</h1>
            <p>This is your personalized home page.</p>
        {% else %}
            <h1>Welcome, Guest!</h1>
            <p>Please log in to access your personalized home page.</p>
        {% endif %}
    </div>
{% endblock %}
