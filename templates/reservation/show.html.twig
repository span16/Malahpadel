{% extends 'base.html.twig' %}

{% block title %}Détails Réservation - {{ reservation.nom }}{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h1 class="h4 mb-0">
                <i class="fas fa-calendar-check me-2"></i> Détails de la réservation
            </h1>
        </div>
        
        <div class="card-body">
            <div class="row mb-4">
                <div class="col-md-6">
                    <h5 class="text-primary">
                        <i class="fas fa-ticket-alt me-2"></i> Informations de réservation
                    </h5>
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item">
                            <strong><i class="fas fa-hashtag me-2"></i>Code :</strong> 
                            <span class="badge bg-secondary">{{ reservation.codeConfirmation }}</span>
                        </li>
                        <li class="list-group-item">
                            <strong><i class="fas fa-tag me-2"></i>Type :</strong> 
                            {{ reservation.typeReservation|capitalize }}
                        </li>
                        <li class="list-group-item">
                            <strong><i class="fas fa-users me-2"></i>Places :</strong> 
                            {{ reservation.nombrePlaces }}
                        </li>
                    </ul>
                </div>
                
                <div class="col-md-6">
                    <h5 class="text-primary">
                        <i class="fas fa-info-circle me-2"></i> Détails supplémentaires
                    </h5>
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item">
                            <strong><i class="fas fa-calendar me-2"></i>Événement :</strong> 
                            {{ reservation.nom }}
                        </li>
                        <li class="list-group-item">
                            <strong><i class="fas fa-comment me-2"></i>Remarques :</strong> 
                            {{ reservation.remarque ?? 'Aucune remarque' }}
                        </li>
                    </ul>
                </div>
            </div>

            <div class="d-flex justify-content-between">
                <a href="{{ path('app_reservation_index') }}" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left me-2"></i> Retour à la liste
                </a>
                
                <div class="btn-group">
                    <a href="{{ path('app_reservation_edit', {'id': reservation.id}) }}" 
                       class="btn btn-outline-primary">
                        <i class="fas fa-edit me-2"></i> Modifier
                    </a>
                    
                    <button type="button" class="btn btn-outline-danger" 
                            data-bs-toggle="modal" data-bs-target="#cancelModal">
                        <i class="fas fa-times me-2"></i> Annuler
                    </button>
                    
                    <form action="{{ path('app_reservation_delete', {'id': reservation.id}) }}" 
                          method="POST" class="d-inline">
                        <input type="hidden" name="_token" 
                               value="{{ csrf_token('delete' ~ reservation.id) }}">
                        <button type="submit" class="btn btn-outline-dark"
                                onclick="return confirm('Supprimer définitivement cette réservation ?')">
                            <i class="fas fa-trash me-2"></i> Supprimer
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal de confirmation d'annulation -->
<div class="modal fade" id="cancelModal" tabindex="-1" aria-labelledby="cancelModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="cancelModalLabel">
                    <i class="fas fa-exclamation-triangle me-2"></i> Confirmer l'annulation
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            
            <div class="modal-body">
                <div class="alert alert-warning">
                    <h6 class="alert-heading">Vous êtes sur le point d'annuler cette réservation :</h6>
                    <hr>
                    <p class="mb-1"><strong>Événement :</strong> {{ reservation.nom }}</p>
                    <p class="mb-1"><strong>Type :</strong> {{ reservation.typeReservation|capitalize }}</p>
                    <p class="mb-0"><strong>Code :</strong> {{ reservation.codeConfirmation }}</p>
                </div>
                
                <p class="mt-3">Vous serez redirigé vers le formulaire de réclamation pour indiquer la raison de cette annulation.</p>
                
                <div class="alert alert-info mt-3">
                    <i class="fas fa-info-circle me-2"></i> Cette action est réversible en contactant le support.
                </div>
            </div>
            
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-2"></i> Annuler
                </button>
                
                <form action="{{ path('app_reservation_cancel', {'id': reservation.id}) }}" method="POST">
                    <input type="hidden" name="_token" value="{{ csrf_token('cancel' ~ reservation.id) }}">
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-check me-2"></i> Confirmer l'annulation
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        // Initialisation des tooltips Bootstrap
        document.addEventListener('DOMContentLoaded', function() {
            const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });
        });
    </script>
{% endblock %}