{% extends 'base.html.twig' %}

{% block title %}Modifier Réservation #{{ reservation.id }}{% endblock %}
 {% block body %}
<div class="container py-4">
    <h1 class="h3 mb-4">Modifier la réservation</h1>

    <div class="card shadow-sm">
        <div class="card-body">
            {{ form_start(form, {
                'attr': {
                    'class': 'needs-validation',
                    'novalidate': 'novalidate'
                }
            }) }}
            
            <div class="row g-3">
                <div class="col-md-6">
                    {{ form_row(form.nom, {
                        'label': 'Nom de l\'événement',
                        'attr': {'class': 'form-control'},
                        'label_attr': {'class': 'form-label fw-bold'}
                    }) }}
                </div>
                
                <div class="col-md-6">
                    {{ form_row(form.typeReservation, {
                        'label': 'Type de réservation',
                        'attr': {'class': 'form-control'},
                        'label_attr': {'class': 'form-label fw-bold'}
                    }) }}
                </div>
                
                <div class="col-md-4">
                    {{ form_row(form.nombrePlaces, {
                        'label': 'Nombre de places',
                        'attr': {'class': 'form-control', 'min': 1},
                        'label_attr': {'class': 'form-label fw-bold'}
                    }) }}
                </div>
                
                <div class="col-12">
                    {{ form_row(form.remarque, {
                        'label': 'Remarques',
                        'attr': {'class': 'form-control', 'rows': 3},
                        'label_attr': {'class': 'form-label fw-bold'}
                    }) }}
                </div>
                
                <div class="col-12">
                    <button type="submit" class="btn btn-primary me-2">
                        <i class="fas fa-save me-2"></i> Enregistrer
                    </button>
                    <a href="{{ path('app_reservation_index') }}" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-2"></i> Retour
                    </a>
                </div>
            </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}