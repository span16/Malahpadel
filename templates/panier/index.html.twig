{% extends 'base.html.twig' %}

{% block title %}Votre Panier - MALAH PADEL{% endblock %}

  {% block body %}
<div class="container py-5">
    <h1 class="mb-4">Votre Panier 
        {% if items|length > 0 %}
            <span class="badge bg-primary rounded-pill fs-6 align-middle">
                {{ items|reduce((carry, item) => carry + item.quantite, 0) }} articles
            </span>
        {% endif %}
    </h1>
    
    {% if items|length > 0 %}
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>Produit</th>
                        <th>Prix unitaire</th>
                        <th>Quantité</th>
                        <th>Total</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for item in items %}
                        <tr>
                            <td>
                                <div class="d-flex align-items-center">
                                    {% if item.produit.imageProduit %}
                                        <img src="{{ asset('uploads/produits/' ~ item.produit.imageProduit) }}" 
                                             alt="{{ item.produit.nomProduit }}" 
                                             class="img-thumbnail me-3" 
                                             style="width: 80px; height: 80px; object-fit: cover;">
                                    {% else %}
                                        <div class="img-thumbnail me-3 d-flex align-items-center justify-content-center" 
                                             style="width: 80px; height: 80px; background: #f8f9fa;">
                                            <i class="fas fa-image fa-2x text-muted"></i>
                                        </div>
                                    {% endif %}
                                    <div>
                                        <h6 class="mb-0">{{ item.produit.nomProduit }}</h6>
                                        <small class="text-muted">{{ item.produit.categorie }}</small>
                                    </div>
                                </div>
                            </td>
                            <td>{{ item.produit.prix|number_format(2, ',', ' ') }} €</td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <a href="{{ path('app_panier_remove', {'id': item.produit.idProduit}) }}" 
                                       class="btn btn-sm btn-outline-secondary">
                                        <i class="fas fa-minus"></i>
                                    </a>
                                    <span class="mx-2">{{ item.quantite }}</span>
                                    <a href="{{ path('app_panier_add', {'id': item.produit.idProduit}) }}" 
                                       class="btn btn-sm btn-outline-secondary">
                                        <i class="fas fa-plus"></i>
                                    </a>
                                </div>
                            </td>
                            <td>{{ item.sousTotal|number_format(2, ',', ' ') }} €</td>
                            <td>
                                <a href="{{ path('app_panier_remove_all', {'id': item.produit.idProduit}) }}" 
                                   class="btn btn-danger btn-sm"
                                   title="Supprimer du panier">
                                    <i class="fas fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
                <tfoot>
                    <tr class="fw-bold">
                        <td colspan="3" class="text-end">Total :</td>
                        <td colspan="2">{{ total|number_format(2, ',', ' ') }} €</td>
                    </tr>
                </tfoot>
            </table>
        </div>
        
        <div class="d-flex justify-content-between mt-4">
            <a href="{{ path('app_produit_index') }}" class="btn btn-outline-primary">
                <i class="fas fa-arrow-left me-1"></i> Continuer mes achats
            </a>
            <div>
                <a href="{{ path('app_panier_clear') }}" class="btn btn-outline-danger me-2">
                    <i class="fas fa-trash-alt me-1"></i> Vider le panier
                </a>
                <a href="{{ path('app_checkout') }}" class="btn btn-primary">
                    <i class="fas fa-credit-card me-1"></i> Passer la commande
                </a>
            </div>
        </div>
    {% else %}
        <div class="alert alert-info text-center py-5">
            <div class="py-3">
                <i class="fas fa-shopping-cart fa-4x text-muted mb-4"></i>
                <h4 class="alert-heading">Votre panier est vide</h4>
                <p class="mb-4">Vous n'avez aucun article dans votre panier.</p>
                <a href="{{ path('app_produit_index') }}" class="btn btn-primary px-4">
                    <i class="fas fa-store me-2"></i> Découvrez nos produits
                </a>
            </div>
        </div>
    {% endif %}
</div>
{% endblock %}