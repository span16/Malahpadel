{% extends 'base.html.twig' %}

{% block title %}Créer un compte{% endblock %}

{% block body %}
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card p-4 shadow-sm">
                    <h2 class="text-center mb-4">Inscription</h2>

                    {% for flash_error in app.flashes('verify_email_error') %}
                        <div class="alert alert-danger" role="alert">{{ flash_error }}</div>
                    {% endfor %}

                    {{ form_start(registrationForm) }}

                    <div class="form-group">
                        <label for="registrationForm_nom" class="form-label">Nom</label>
                        {{ form_widget(registrationForm.nom, { 'attr': {'class': 'form-control'} }) }}
                        {{ form_errors(registrationForm.nom) }}
                    </div>

                    <div class="form-group">
                        <label for="registrationForm_prenom" class="form-label">Prénom</label>
                        {{ form_widget(registrationForm.prenom, { 'attr': {'class': 'form-control'} }) }}
                        {{ form_errors(registrationForm.prenom) }}
                    </div>

                    <div class="form-group">
                        <label for="registrationForm_age" class="form-label">Âge</label>
                        {{ form_widget(registrationForm.age, { 'attr': {'class': 'form-control'} }) }}
                        {{ form_errors(registrationForm.age) }}
                    </div>

                    <div class="form-group">
                        <label for="registrationForm_email" class="form-label">Email</label>
                        {{ form_widget(registrationForm.email, { 'attr': {'class': 'form-control'} }) }}
                        {{ form_errors(registrationForm.email) }}
                    </div>

                    <div class="form-group">
                        <label for="registrationForm_plainPassword" class="form-label">Mot de passe</label>
                        {{ form_widget(registrationForm.plainPassword, { 'attr': {'class': 'form-control'} }) }}
                        {{ form_errors(registrationForm.plainPassword) }}
                    </div>

                    <div class="form-group">
                        <label for="registrationForm_cin" class="form-label">CIN</label>
                        {{ form_widget(registrationForm.cin, { 'attr': {'class': 'form-control'} }) }}
                        {{ form_errors(registrationForm.cin) }}
                    </div>

                    <div class="form-check">
                        <label for="registrationForm_agreeTerms" class="form-check-label">
                            {{ form_widget(registrationForm.agreeTerms) }} 
                            Accepter les conditions d’utilisation
                        </label>
                        {{ form_errors(registrationForm.agreeTerms) }}
                    </div>

                    <button type="submit" class="btn btn-primary w-100 mt-3">S'inscrire</button>

                    {{ form_end(registrationForm) }}

                    <p class="text-center mt-3">
                        Déjà un compte ? <a href="{{ path('app_login') }}">Se connecter</a>
                    </p>

                    <div class="text-center mt-4">
                        <p>Ou inscrivez-vous avec</p>
                        <div class="d-flex justify-content-center">
                           

                            <!-- Facebook Button -->
                            <a class="btn btn-primary btn-sm-square rounded-circle me-3" href="#">
                                <i class="fab fa-facebook-f text-white"></i>
                            </a>

                            <!-- Twitter Button -->
                            <a class="btn btn-primary btn-sm-square rounded-circle me-3" href="#">
                                <i class="fab fa-twitter text-white"></i>
                            </a>

                            <!-- Apple Button -->
                            <a class="btn btn-primary btn-sm-square rounded-circle me-3" href="#">
                                <i class="fab fa-apple text-white"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
