{% extends 'base.html.twig' %}

{% block title %}Détails de la campagne - {{ compagne.nomSponsor }}{% endblock %}

{% block body %}
    <div class="container mt-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="mb-0">Détails de la campagne</h1>
            <div class="btn-group">
                <a href="{{ path('app_compagne_index') }}" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left"></i> Retour à la liste
                </a>
                <a href="{{ path('app_compagne_edit', {'idCompagne': compagne.idCompagne}) }}" class="btn btn-primary">
                    <i class="fas fa-edit"></i> Modifier
                </a>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="row g-0">
                <div class="col-md-4 border-end">
                    {% if compagne.logoCompagne %}
                        <img src="{{ asset('uploads/logos/' ~ compagne.logoCompagne) }}" 
                             class="img-fluid rounded-start p-3" 
                             alt="Logo {{ compagne.nomSponsor }}">
                    {% else %}
                        <div class="p-5 text-center text-muted bg-light">
                            <i class="fas fa-image fa-4x mb-3"></i>
                            <p>Aucun logo disponible</p>
                        </div>
                    {% endif %}
                </div>
                <div class="col-md-8">
                    <div class="card-body">
                        <table class="table table-borderless">
                            <tbody>
                                <tr>
                                    <th class="w-25">ID Campagne</th>
                                    <td>{{ compagne.idCompagne }}</td>
                                </tr>
                                <tr>
                                    <th>Nom Sponsor</th>
                                    <td class="h5">{{ compagne.nomSponsor }}</td>
                                </tr>
                                <tr>
                                    <th>Tarifs</th>
                                    <td class="h4 text-success">{{ compagne.tarifs|number_format(2, ',', ' ') }} €</td>
                                </tr>
                                <tr>
                                    <th>Période</th>
                                    <td>
                                        Du <strong>{{ compagne.dateDebut ? compagne.dateDebut|date('d/m/Y') : '' }}</strong>
                                        au <strong>{{ compagne.dateFin ? compagne.dateFin|date('d/m/Y') : '' }}</strong>
                                    </td>
                                </tr>
                                <tr>
                                    <th>Statut</th>
                                    <td>
                                        <span class="badge 
                                            {{ compagne.status == 'active' ? 'bg-success' : 
                                               (compagne.status == 'inactive' ? 'bg-danger' : 'bg-warning text-dark') }}">
                                            {{ compagne.status|capitalize }}
                                        </span>
                                    </td>
                                </tr>
                                <tr>
                                    <th>Type Marketing</th>
                                    <td>{{ compagne.typeMarketing }}</td>
                                </tr>
                                <tr>
                                    <th>Produit associé</th>
                                    <td>
                                        {% if compagne.produit %}
                                            {{ compagne.produit.nomProduit }}
                                        {% else %}
                                            <span class="text-muted">Aucun produit associé</span>
                                        {% endif %}
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="card-footer text-end">
                {{ include('compagne/_delete_form.html.twig') }}
            </div>
        </div>
    </div>
{% endblock %}