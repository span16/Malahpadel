{% extends 'base.html.twig' %}

{% block title %}Ajouter un produit - MALAH PADEL{% endblock %}

{% block body %}


    <!-- Navbar (identique à votre template de base) -->
   
      
    <!-- Votre contenu existant inchangé -->
    <div class="container-fluid hero-header bg-light py-5 mb-5">
        <div class="container py-5">
            <div class="row g-5 align-items-center">
                <div class="col-lg-12 text-center">
                    <h1 class="display-4 mb-3 animated slideInDown">Ajouter un nouveau produit</h1>
                </div>
            </div>
        </div>
    </div>

    <div class="container-xxl py-5">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-8">
                    <div class="card shadow-sm">
                        <div class="card-body">
                            {{ form_start(form, {
                                'attr': {
                                    'class': 'form-horizontal',
                                    'novalidate': 'novalidate'
                                }
                            }) }}
                            
                                {# Nom du produit #}
                                <div class="mb-3">
                                    {{ form_label(form.nom_produit) }}
                                    {{ form_widget(form.nom_produit) }}
                                    {{ form_errors(form.nom_produit) }}
                                </div>
                                
                                {# Catégorie #}
                                <div class="mb-3">
                                    {{ form_label(form.categorie) }}
                                    {{ form_widget(form.categorie) }}
                                    {{ form_errors(form.categorie) }}
                                </div>
                                
                                {# Prix #}
                                <div class="mb-3">
                                    {{ form_label(form.prix) }}
                                    <div class="input-group">
                                        <span class="input-group-text">€</span>
                                        {{ form_widget(form.prix) }}
                                    </div>
                                    {{ form_errors(form.prix) }}
                                </div>
                                
                                {# Stock #}
                                <div class="mb-3">
                                    {{ form_label(form.stock) }}
                                    {{ form_widget(form.stock) }}
                                    {{ form_errors(form.stock) }}
                                </div>
                                
                                {# Description #}
                                <div class="mb-3">
                                    {{ form_label(form.description) }}
                                    {{ form_widget(form.description) }}
                                    {{ form_errors(form.description) }}
                                </div>
                                
                                {# Image #}
                                <div class="mb-3">
                                    {{ form_label(form.image_produit) }}
                                    {{ form_widget(form.image_produit) }}
                                    <small class="text-muted">Formats acceptés: JPG, PNG (max 2MB)</small>
                                    {{ form_errors(form.image_produit) }}
                                </div>
                                
                                <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                                    <a href="{{ path('app_produit_index') }}" class="btn btn-secondary me-md-2">
                                        <i class="fas fa-arrow-left me-2"></i> Annuler
                                    </a>
                                    <button type="submit" class="btn btn-primary">
                                        <i class="fas fa-save me-2"></i> Enregistrer
                                    </button>
                                </div>
                            {{ form_end(form) }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer (identique à votre template de base) -->
    <div class="container-fluid footer py-5 wow fadeIn" data-wow-delay="0.2s">
        <div class="container py-5 border-start-0 border-end-0" style="border: 1px solid; border-color: rgb(255, 255, 255, 0.08);">
            <div class="row g-5">
                <div class="col-md-6 col-lg-6 col-xl-4">
                    <div class="footer-item">
                        <a href="{{ path('app_produit_index') }}" class="p-0">
                            <h4 class="text-white"><i class="fas fa-store me-3"></i>MALAH PADEL</h4>
                        </a>
                        <p class="mb-4">Votre destination premium pour l'équipement de padel au Maroc.</p>
                        <div class="d-flex">
                            <a href="#" class="btn btn-primary btn-sm-square rounded-circle me-2"><i class="fab fa-facebook-f"></i></a>
                            <a href="#" class="btn btn-primary btn-sm-square rounded-circle me-2"><i class="fab fa-instagram"></i></a>
                            <a href="#" class="btn btn-primary btn-sm-square rounded-circle"><i class="fab fa-linkedin-in"></i></a>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-6 col-xl-2">
                    <div class="footer-item">
                        <h4 class="text-white mb-4">Liens rapides</h4>
                        <a href="{{ path('app_produit_index') }}" class="mb-2"><i class="fas fa-angle-right me-2"></i>Accueil</a>
                        <a href="{{ path('app_produit_index') }}" class="mb-2"><i class="fas fa-angle-right me-2"></i>Produits</a>
                        <!-- ... autres liens ... -->
                    </div>
                </div>
                <div class="col-md-6 col-lg-6 col-xl-3">
                    <div class="footer-item">
                        <h4 class="text-white mb-4">Contact</h4>
                        <p><i class="fas fa-map-marker-alt me-2"></i>Casablanca, Maroc</p>
                        <p><i class="fas fa-phone-alt me-2"></i>+212 600-000000</p>
                        <p><i class="fas fa-envelope me-2"></i>contact@malahpadel.com</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Copyright (identique à votre template de base) -->
    <div class="container-fluid copyright py-4">
        <div class="container">
            <div class="row">
                <div class="col-md-6 text-center text-md-start">
                    <span class="text-light">&copy; <span id="current-year"></span> <a href="#">MALAH PADEL</a>, Tous droits réservés.</span>
                </div>
                <div class="col-md-6 text-center text-md-end">
                    <span class="text-light">Développé par <a href="#">Votre équipe</a></span>
                </div>
            </div>
        </div>
    </div>

    <!-- Back to Top Button -->
    <a href="#" class="btn btn-primary btn-lg-square rounded-circle back-to-top"><i class="fa fa-arrow-up"></i></a>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        // Current year for copyright
        document.getElementById('current-year').textContent = new Date().getFullYear();
        
        // Back to top button
        window.onscroll = function() {
            if (document.body.scrollTop > 100 || document.documentElement.scrollTop > 100) {
                document.querySelector('.back-to-top').style.display = 'block';
            } else {
                document.querySelector('.back-to-top').style.display = 'none';
            }
        };
    </script>
{% endblock %}