{% extends 'back.html.twig' %}

{% block title %}Gestion des Campagnes - Admin{% endblock %}

{% block body %}
<div class="content-wrapper">
    <div class="page-header">
        <h3 class="page-title">Gestion des campagnes</h3>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Tableau de bord</a></li>
                <li class="breadcrumb-item active" aria-current="page">Campagnes</li>
            </ol>
        </nav>
    </div>

    <div class="row">
        <!-- Formulaire d'ajout ou d'édition -->
        {% if form is defined and form is not null %}
        <div class="col-md-4 grid-margin stretch-card">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">{{ form_title|default('Ajouter une campagne') }}</h4>
                    
                    {{ form_start(form, {'attr': {'class': 'forms-sample', 'novalidate': 'novalidate'}}) }}
                    <div class="form-group">
                        {{ form_label(form.nomSponsor) }}
                        {{ form_widget(form.nomSponsor, {'attr': {'class': 'form-control', 'placeholder': 'Nom du sponsor'}}) }}
                        <small class="text-danger">{{ form_errors(form.nomSponsor) }}</small>
                    </div>
                    <div class="form-group">
                        {{ form_label(form.tarifs) }}
                        <div class="input-group">
                            <span class="input-group-text">€</span>
                            {{ form_widget(form.tarifs, {'attr': {'class': 'form-control', 'placeholder': 'Tarifs'}}) }}
                        </div>
                        <small class="text-danger">{{ form_errors(form.tarifs) }}</small>
                    </div>
                    <div class="form-group">
                        {{ form_label(form.dateDebut) }}
                        {{ form_widget(form.dateDebut, {'attr': {'class': 'form-control'}}) }}
                        <small class="text-danger">{{ form_errors(form.dateDebut) }}</small>
                    </div>
                    <div class="form-group">
                        {{ form_label(form.dateFin) }}
                        {{ form_widget(form.dateFin, {'attr': {'class': 'form-control'}}) }}
                        <small class="text-danger">{{ form_errors(form.dateFin) }}</small>
                    </div>
                    <div class="form-group">
                        {{ form_label(form.logoCompagne) }}
                        {{ form_widget(form.logoCompagne, {'attr': {'class': 'form-control file-upload-info'}}) }}
                        <small class="text-muted">Formats: JPG, PNG, GIF (max 2MB)</small>
                        <small class="text-danger">{{ form_errors(form.logoCompagne) }}</small>
                    </div>
                    <div class="form-group">
                        {{ form_label(form.status) }}
                        {{ form_widget(form.status, {'attr': {'class': 'form-control'}}) }}
                        <small class="text-danger">{{ form_errors(form.status) }}</small>
                    </div>
                    <div class="form-group">
                        {{ form_label(form.typeMarketing) }}
                        {{ form_widget(form.typeMarketing, {'attr': {'class': 'form-control'}}) }}
                        <small class="text-danger">{{ form_errors(form.typeMarketing) }}</small>
                    </div>
                    <div class="form-group">
                        {{ form_label(form.produit) }}
                        {{ form_widget(form.produit, {'attr': {'class': 'form-control'}}) }}
                        <small class="text-danger">{{ form_errors(form.produit) }}</small>
                    </div>
                    <div class="d-flex justify-content-between mt-4">
                        <a href="{{ path('admin_compagne_index') }}" class="btn btn-light">
                            <i class="mdi mdi-arrow-left"></i> Annuler
                        </a>
                        <button type="submit" class="btn btn-primary mr-2">
                            <i class="mdi mdi-content-save"></i> {{ button_label|default('Enregistrer') }}
                        </button>
                    </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
        {% endif %}

        <!-- Liste des campagnes -->
        {% if campagnes is not null %}
        <div class="col-md-{{ form is null ? '12' : '8' }} grid-margin stretch-card">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h4 class="card-title">Liste des campagnes</h4>
                        <span class="badge bg-primary text-white">Nombre de campagnes : {{ total_compagnes }}</span>
                    </div>
                    <div class="d-flex flex-wrap gap-3">
                        {% for compagne in campagnes %}
                        <div class="card" style="width: 18rem;">
                            <div class="card-body d-flex flex-column">
                                {% if compagne.logoCompagne and compagne.logoCompagne != 'default-logo.png' %}
                                    <img src="{{ asset('uploads/logos/' ~ compagne.logoCompagne) }}" 
                                         class="card-img-top" 
                                         style="height: 150px; object-fit: cover;" 
                                         alt="{{ compagne.nomSponsor }}">
                                {% else %}
                                    <div class="d-flex align-items-center justify-content-center" 
                                         style="height: 150px; background-color: #f5f5f5;">
                                        <i class="mdi mdi-image-off text-muted" style="font-size: 2rem;"></i>
                                    </div>
                                {% endif %}
                                <h5 class="card-title mt-2">{{ compagne.nomSponsor }}</h5>
                                <p class="card-text">
                                    <strong>Type:</strong> {{ compagne.typeMarketing }}<br>
                                    <strong>Tarifs:</strong> {{ compagne.tarifs|number_format(2, ',', ' ') }} €<br>
                                    <strong>Statut:</strong> 
                                    <span class="badge badge-{{ compagne.status == 'active' ? 'success' : (compagne.status == 'inactive' ? 'danger' : 'warning') }}">
                                        {{ compagne.status }}
                                    </span>
                                </p>
                                <div class="mt-auto d-flex justify-content-between">
                                    <a href="{{ path('admin_compagne_edit', {'idCompagne': compagne.idCompagne}) }}" 
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="mdi mdi-pencil"></i> Modifier
                                    </a>
                                    <form method="post" 
                                          action="{{ path('admin_compagne_delete', {'idCompagne': compagne.idCompagne}) }}" 
                                          onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette campagne ?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ compagne.idCompagne) }}">
                                        <button class="btn btn-sm btn-outline-danger">
                                            <i class="mdi mdi-delete"></i> Supprimer
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                        {% else %}
                        <div class="text-center w-100 py-4 text-muted">
                            Aucune campagne trouvée
                        </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
        {% endif %}
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
    document.addEventListener('DOMContentLoaded', function() {
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl);
        });
    });
</script>
{% endblock %}