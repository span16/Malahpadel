{{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}
    <div class="row">
        <div class="col-md-6">
            {{ form_row(form.senderId, {
                'label': 'ID Expéditeur',
                'attr': {'class': 'form-control'}
            }) }}
        </div>
        <div class="col-md-6">
            {{ form_row(form.receiverId, {
                'label': 'ID Destinataire',
                'attr': {'class': 'form-control'}
            }) }}
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-md-6">
            {{ form_row(form.statut, {
                'label': 'Statut',
                'attr': {'class': 'form-control'}
            }) }}
        </div>
        <div class="col-md-6">
            {{ form_row(form.dateEnvoi, {
                'label': 'Date d\'envoi',
                'attr': {'class': 'form-control'}
            }) }}
        </div>
    </div>

    <div class="mt-4">
        <button class="btn btn-primary">
            <i class="fas fa-save"></i>
            {{ button_label|default('Enregistrer') }}
        </button>
    </div>
{{ form_end(form) }} 