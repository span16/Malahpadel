{% extends 'back/base.html.twig' %}

{% block title %}Liste des Invitations{% endblock %}

{% block body %}
    <div class="container-fluid">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1>Liste des invitations</h1>
            <a href="{{ path('back_invitation_new') }}" class="btn btn-primary">
                <i class="fas fa-plus"></i> Nouvelle invitation
            </a>
        </div>

        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>ID Expéditeur</th>
                                <th>ID Destinataire</th>
                                <th>Statut</th>
                                <th>Date d'envoi</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for invitation in invitations %}
                            <tr>
                                <td>{{ invitation.id }}</td>
                                <td>{{ invitation.senderId }}</td>
                                <td>{{ invitation.receiverId }}</td>
                                <td>{{ invitation.statut.value }}</td>
                                <td>{{ invitation.dateEnvoi ? invitation.dateEnvoi|date('Y-m-d H:i:s') : '' }}</td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a href="{{ path('back_invitation_show', {'id': invitation.id}) }}" class="btn btn-info btn-sm" title="Voir">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a href="{{ path('back_invitation_edit', {'id': invitation.id}) }}" class="btn btn-primary btn-sm" title="Modifier">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="6" class="text-center">Aucune invitation trouvée</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
{% endblock %} 