{% extends 'back/base.html.twig' %}

{% block title %}Détails de l'Invitation{% endblock %}

{% block body %}
    <div class="container-fluid">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1>Détails de l'invitation</h1>
            <a href="{{ path('back_invitation_index') }}" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Retour à la liste
            </a>
        </div>

        <div class="card">
            <div class="card-body">
                <table class="table">
                    <tbody>
                        <tr>
                            <th>ID</th>
                            <td>{{ invitation.id }}</td>
                        </tr>
                        <tr>
                            <th>ID Expéditeur</th>
                            <td>{{ invitation.senderId }}</td>
                        </tr>
                        <tr>
                            <th>ID Destinataire</th>
                            <td>{{ invitation.receiverId }}</td>
                        </tr>
                        <tr>
                            <th>Statut</th>
                            <td>{{ invitation.statut.value }}</td>
                        </tr>
                        <tr>
                            <th>Date d'envoi</th>
                            <td>{{ invitation.dateEnvoi ? invitation.dateEnvoi|date('Y-m-d H:i:s') : '' }}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="mt-3">
            <a href="{{ path('back_invitation_edit', {'id': invitation.id}) }}" class="btn btn-primary me-2">
                <i class="fas fa-edit"></i> Modifier
            </a>
            {{ include('back/invitation/_delete_form.html.twig') }}
        </div>
    </div>
{% endblock %} 