<form method="post" action="{{ path('app_equipes_delete', {'equipe_id': equipe.equipe_id}) }}" onsubmit="return confirm('Are you sure you want to delete this item?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ equipe.equipe_id) }}">
    <button class="btn">Delete</button>
</form>
