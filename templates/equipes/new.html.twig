{% extends 'Back.html.twig' %}

{% block title %}Créer une nouvelle équipe{% endblock %}

{% block body %}
<div class="container mt-5">
    <h2 class="mb-4 text-center">Créer une nouvelle équipe</h2>

    {# ✅ Affichage des messages flash #}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label == 'success' ? 'success' : 'danger' }}">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}

    {{ form_start(form) }}
        <div class="mb-3">
            {{ form_label(form.nom_equipe) }}
            {{ form_widget(form.nom_equipe, { 'attr': {'class': 'form-control'} }) }}
            {{ form_errors(form.nom_equipe) }}
        </div>

        <div class="mb-3">
            {{ form_label(form.joueur1) }}
            {{ form_widget(form.joueur1, { 'attr': {'class': 'form-select'} }) }}
            {{ form_errors(form.joueur1) }}
        </div>

        <div class="mb-3">
            {{ form_label(form.joueur2) }}
            {{ form_widget(form.joueur2, { 'attr': {'class': 'form-select'} }) }}
            {{ form_errors(form.joueur2) }}
        </div>

        <button type="submit" class="btn btn-success">
            <i class="fas fa-plus-circle"></i> Ajouter l'équipe
        </button>
        <a href="{{ path('equipe_index') }}" class="btn btn-secondary">Retour</a>
    {{ form_end(form) }}
</div>
{% endblock %}
