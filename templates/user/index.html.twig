{% extends 'back.html.twig' %}

{% block title %}Dashboard Utilisateurs{% endblock %}

{% block body %}
<div class="container mt-5">
    <h1 class="mb-4">Dashboard des utilisateurs</h1>

    <div class="mb-3">
        <a href="{{ path('app_user_new') }}" class="btn btn-success">Ajouter un utilisateur</a>
    </div>

    <form method="get" class="mb-4">
        <input type="text" name="search" value="{{ search ?? '' }}" placeholder="Rechercher par nom ou email" class="form-control w-25 d-inline-block me-2">
        <button type="submit" class="btn btn-primary">Rechercher</button>
    </form>

    <div class="row mb-4">
        <div class="col">
            <div class="alert alert-info">Total utilisateurs : {{ totalUsers ?? users|length }}</div>
        </div>
        <div class="col">
            <div class="alert alert-warning">Admins : {{ adminCount ?? 0 }}</div>
        </div>
        <div class="col">
            <div class="alert alert-secondary">Utilisateurs : {{ userCount ?? 0 }}</div>
        </div>
    </div>

    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Nom</th>
                <th>Email</th>
                <th>Rôles</th>
                <th>État</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for user in users %}
                <tr>
                    <td>{{ user.id }}</td>
                    <td>{{ user.nom }} {{ user.prenom }}</td>
                    <td>{{ user.email }}</td>
                    <td>{{ user.roles|join(', ') }}</td>
                    <td>{{ user.etat }}</td>
                    <td>
                        <a href="{{ path('app_user_show', {'id': user.id}) }}" class="btn btn-sm btn-info">Voir</a>
                        <a href="{{ path('app_user_edit', {'id': user.id}) }}" class="btn btn-sm btn-primary">Modifier</a>
                        {{ include('user/_delete_form.html.twig', {'user': user}) }}
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="6">Aucun utilisateur trouvé.</td></tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
