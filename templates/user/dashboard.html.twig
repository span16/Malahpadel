{% extends 'back.html.twig' %}

{% block title %}Dashboard Utilisateurs{% endblock %}

{% block body %}
<div class="container mt-5">

    <h1 class="mb-4">Dashboard des Utilisateurs</h1>

    {# Affichage des statistiques sous forme de cartes ou alertes #}
    <div class="row mb-4">
        <div class="col">
            <div class="alert alert-info text-center">
                <strong>Total Utilisateurs :</strong> {{ totalUsers }}
            </div>
        </div>
        <div class="col">
            <div class="alert alert-warning text-center">
                <strong>Admins :</strong> {{ adminCount }}
            </div>
        </div>
        <div class="col">
            <div class="alert alert-secondary text-center">
                <strong>Utilisateurs :</strong> {{ userCount }}
            </div>
        </div>
    </div>

    {# Bouton pour ajouter un nouvel utilisateur #}
    <div class="mb-3">
        <a href="{{ path('app_user_new') }}" class="btn btn-success">➕ Ajouter un utilisateur</a>
    </div>

    {# Formulaire de recherche multicritères #}
    <form method="get" class="mb-4">
        <div class="row">
            <div class="col-md-3">
                <input type="text" name="nom" value="{{ nom ?? '' }}" class="form-control" placeholder="Nom">
            </div>
            <div class="col-md-3">
                <input type="text" name="email" value="{{ email ?? '' }}" class="form-control" placeholder="Email">
            </div>
            <div class="col-md-2">
                <select name="fonction" class="form-control">
                    <option value="">Fonction</option>
                    <option value="admin" {% if fonction == 'admin' %}selected{% endif %}>Administrateur</option>
                    <option value="utilisateur" {% if fonction == 'utilisateur' %}selected{% endif %}>Utilisateur</option>
                </select>
            </div>
            <div class="col-md-2">
                <input type="text" name="etat" value="{{ etat ?? '' }}" class="form-control" placeholder="État">
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-outline-primary btn-block">Rechercher</button>
            </div>
        </div>
    </form>

    {# Tableau des utilisateurs #}
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Nom</th>
                <th>Email</th>
                <th>Fonction</th>
                <th>Rôles</th>
                <th>État</th>
                 <th>profil</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for user in users %}
                <tr>
                    <td>{{ user.id }}</td>
                    <td>{{ user.nom }} {{ user.prenom }}</td>
                    <td>{{ user.email }}</td>
                    <td>{{ user.fonction }}</td>
                    <td>{{ user.roles|join(', ') }}</td>
                    <td>{{ user.etat }}</td>
                     <td>
                        {% if user.profil is not null %}
                            {# Exemple : afficher l'avatar et un extrait de la bio du profil #}
                            <img src="/uploads/avatars/{{ user.profil.avatar }}" alt="Avatar" width="50" class="img-thumbnail">
                            <p class="small mt-1">{{ user.profil.bio|default('N/A') }}</p>
                        {% else %}
                            <span class="text-muted">Aucun profil</span>
                        {% endif %}
                    </td>
         <td>
        <a href="{{ path('app_user_show', {'id': user.id}) }}" class="btn btn-sm btn-info me-2">Voir</a>
</td>

                </tr>
            {% else %}
                <tr>
                    <td colspan="7" class="text-center">Aucun utilisateur trouvé.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

</div>
{% endblock %}
