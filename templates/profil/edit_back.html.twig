{% extends 'back.html.twig' %}

{% block title %}Modifier le Profil{% endblock %}

{% block body %}
<div class="container mt-5">
  <div class="card bg-dark text-white shadow-lg">
    <div class="card-header bg-gradient-primary">
      <h3 class="mb-0 text-center text-uppercase">Modifier le Profil</h3>
    </div>

    <div class="card-body">
      {{ form_start(form, {'attr': {'enctype': 'multipart/form-data'}}) }}

      <div class="mb-4">
        {{ form_label(form.avatar, 'Photo de profil', {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.avatar, {'attr': {'class': 'form-control bg-dark text-white border-light'}}) }}
        {{ form_errors(form.avatar) }}
      </div>

      <div class="mb-4">
        {{ form_label(form.bio, 'Biographie', {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.bio, {'attr': {'class': 'form-control bg-dark text-white border-light', 'rows': 4}}) }}
        {{ form_errors(form.bio) }}
      </div>

      <div class="mb-4">
        {{ form_label(form.preferences, 'Préférences', {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.preferences, {'attr': {'class': 'form-control bg-dark text-white border-light'}}) }}
        {{ form_errors(form.preferences) }}
      </div>

      <div class="d-flex justify-content-end gap-2">
        <button type="submit" class="btn btn-success">
          <i class="mdi mdi-content-save"></i> Sauvegarder
        </button>
        <a href="{{ path('app_profil_show_back', {'id': profil.id}) }}" class="btn btn-secondary">
          <i class="mdi mdi-arrow-left"></i> Retour
        </a>
      </div>

      {{ form_end(form) }}
    </div>
  </div>
</div>
{% endblock %}
