{# templates/profil/index.html.twig #}

{% extends 'base.html.twig' %}

{% block title %}Mes Profils{% endblock %}

{% block body %}
    <h1>Mes Profils</h1>

    {% if app.user %}
        <a href="{{ path('app_profil_new') }}" class="btn btn-primary">Créer un nouveau profil</a>

        <table class="table mt-3">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nom</th>
                    <th>Avatar</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for profil in profils %}
                    <tr>
                        <td>{{ profil.id }}</td>
                        <td>{{ profil.bio ? profil.bio : 'Non défini' }}</td>
                        <td>
                            {% if profil.avatar %}
                                <img src="{{ asset('uploads/avatars/' ~ profil.avatar) }}" alt="Avatar" width="50">
                            {% else %}
                                <span>Aucun avatar</span>
                            {% endif %}
                        </td>
                        <td>
                            <a href="{{ path('app_profil_show', {'id': profil.id}) }}" class="btn btn-info">Voir</a>
                            <a href="{{ path('app_profil_edit', {'id': profil.id}) }}" class="btn btn-warning">Éditer</a>
                            <form method="post" action="{{ path('app_profil_delete', {'id': profil.id}) }}" style="display:inline;">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ profil.id) }}">
                                <button type="submit" class="btn btn-danger">Supprimer</button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="4" class="text-center">Aucun profil trouvé.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% else %}
        <p>Veuillez vous connecter pour accéder à vos profils.</p>
    {% endif %}
{% endblock %}
