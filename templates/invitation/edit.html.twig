{% extends 'invitation/base.html.twig' %}

{% block title %}Modifier l'invitation{% endblock %}

{% block body %}
    <div class="card">
        <div class="card-header">
            <h1 class="h3 mb-0">Modifier l'invitation</h1>
        </div>
        <div class="card-body">
            {{ include('invitation/_form.html.twig', {'button_label': 'Mettre à jour'}) }}
        </div>
        <div class="card-footer">
            <a href="{{ path('app_invitation_index') }}" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Retour à la liste
            </a>
            {{ include('invitation/_delete_form.html.twig') }}
        </div>
    </div>
{% endblock %} 