<form action="{{ path('app_invitation_delete', {'id': invitation.id}) }}" method="post" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette invitation ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ invitation.id) }}">
    <button class="btn btn-danger" type="submit">
        <i class="fas fa-trash-alt"></i> Supprimer
    </button>
</form>
