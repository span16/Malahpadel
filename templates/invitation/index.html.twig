{% extends 'invitation/base.html.twig' %}

{% block title %}Invitations{% endblock %}

{% block body %}
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h1 class="h3 mb-0">Invitations</h1>
            <a href="{{ path('app_invitation_new') }}" class="btn btn-primary">
                <i class="fas fa-plus"></i> Nouvelle invitation
            </a>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>ID Expéditeur</th>
                            <th>ID Destinataire</th>
                            <th>Statut</th>
                            <th>Date d'envoi</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for invitation in invitations %}
                            <tr>
                                <td>{{ invitation.senderId }}</td>
                                <td>{{ invitation.receiverId }}</td>
                                <td>
                                    {% if invitation.statut == constant('App\\Entity\\InvitationStatus::EN_ATTENTE') %}
                                        En attente
                                    {% elseif invitation.statut == constant('App\\Entity\\InvitationStatus::ACCEPTEE') %}
                                        Acceptée
                                    {% elseif invitation.statut == constant('App\\Entity\\InvitationStatus::REFUSEE') %}
                                        Refusée
                                    {% endif %}
                                </td>
                                <td>{{ invitation.dateEnvoi ? invitation.dateEnvoi|date('Y-m-d H:i:s') : '' }}</td>
                                <td>
                                    <a href="{{ path('app_invitation_show', {'id': invitation.id}) }}" class="btn btn-info btn-sm">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a href="{{ path('app_invitation_edit', {'id': invitation.id}) }}" class="btn btn-warning btn-sm">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="5" class="text-center">Aucune invitation trouvée</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %} 